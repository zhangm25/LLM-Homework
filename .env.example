# ============================================================================
# RoamMind — 单一配置文件模板
# ----------------------------------------------------------------------------
# 用法：把本文件复制为同目录下的 .env，然后填入你的 Key 即可。
#     cp .env.example .env
#
# 说明：
#   * 后端（FastAPI）读取 LLM、高德 Web 服务 Key，并在运行时把浏览器侧高德 JS 配置
#     通过 /api/config 下发给前端；发布包不需要把真实 Key 打进构建产物。
#   * DeepSeek / 高德 Web 服务 Key 不会泄露到浏览器；VITE_AMAP_JS_* 属于浏览器侧公共配置，
#     只用于加载高德 JS 地图，建议在高德控制台配置域名白名单。
#   * 任何一个 Key 留空都能跑：留空即进入「示例模式」，预置 4 个场景仍可完整演示。
#   * 真实 Key 请只写进 .env（已被 .gitignore 忽略），不要写进本模板文件。
# ============================================================================

# --- LLM (OpenAI-compatible; backend) -------------------------------------
# Preferred generic config. For Zhipu, use:
# LLM_PROVIDER=zhipu
# LLM_API_KEY=your_zhipu_api_key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash-250414
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Legacy DeepSeek fallback ---------------------------------------------
# 控制台：https://platform.deepseek.com/  →  API Keys
DEEPSEEK_API_KEY=
# 一般无需改动：
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat 当前映射到 DeepSeek-V4-Flash；如需显式可改为 deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-chat

# --- 高德地图 · Web 服务 Key（POI 检索 / 路径规划；后端用）-------------------
# 控制台 console.amap.com → 应用管理 → 新建应用 → 添加 Key → 服务平台选「Web服务」
AMAP_WEB_SERVICE_KEY=

# --- 高德地图 · JS API Key（前端地图渲染；前端用）---------------------------
# 同控制台再加一个 Key，服务平台选「Web端(JS API)」。2021-12 起必须配安全密钥。
# 建议在控制台设置域名白名单。留空则前端用内置 SVG 路线图兜底。
VITE_AMAP_JS_KEY=
VITE_AMAP_JS_SECURITY_CODE=

# --- 前端访问后端的地址（仅开发模式需要；发布版默认同源 /api）---------------
VITE_API_BASE_URL=http://localhost:8000
